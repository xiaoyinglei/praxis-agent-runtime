[importlinter]
root_packages =
    agent_runtime
    praxis
    rag

[importlinter:contract:runtime_rag_boundary]
name = Runtime depends on RAG only through the knowledge adapter
type = forbidden
source_modules =
    agent_runtime
forbidden_modules =
    rag
ignore_imports =
    agent_runtime.knowledge_providers.rag -> rag
    agent_runtime.knowledge_providers.rag -> rag.models.assembly_adapter
    agent_runtime.knowledge_providers.rag -> rag.models.runtime
    agent_runtime.knowledge_providers.rag -> rag.retrieval
    agent_runtime.knowledge_providers.rag -> rag.runtime
    agent_runtime.knowledge_providers.rag -> rag.storage.runtime_config
allow_indirect_imports = true

[importlinter:contract:schema_foundation]
name = RAG schema remains independent from runtime orchestration
type = forbidden
source_modules =
    rag.schema
forbidden_modules =
    agent_runtime.runtime
    agent_runtime.tools

[importlinter:contract:tools_boundary]
name = Runtime tools do not depend on Harness orchestration
type = forbidden
source_modules =
    agent_runtime.tools
forbidden_modules =
    agent_runtime.harness.services
    agent_runtime.harness.session
    agent_runtime.harness.execution

[importlinter:contract:harness_components_do_not_depend_on_session]
name = Harness components do not depend on Session internals
type = forbidden
source_modules =
    agent_runtime.harness.context
    agent_runtime.harness.events
    agent_runtime.harness.model_adapter
    agent_runtime.harness.protocol
    agent_runtime.harness.reducer
    agent_runtime.harness.rollout
    agent_runtime.harness.runtime_store
    agent_runtime.harness.runtime_tx
    agent_runtime.harness.execution_context
    agent_runtime.harness.request_context
    agent_runtime.harness.responses
    agent_runtime.harness.stop
    agent_runtime.harness.budget_context
    agent_runtime.harness.execution_facts
    agent_runtime.harness.control
    agent_runtime.harness.context_rendering
    agent_runtime.harness.context_engine
    agent_runtime.harness.context_policy
    agent_runtime.harness.compaction_jobs
    agent_runtime.harness.model_runner
    agent_runtime.harness.prepared_requests
    agent_runtime.harness.artifact_ops
    agent_runtime.harness.budget_ops
    agent_runtime.harness.completion_ops
    agent_runtime.harness.context_ops
    agent_runtime.harness.facts
    agent_runtime.harness.memory_ops
    agent_runtime.harness.model_ops
    agent_runtime.harness.model_retry_ops
    agent_runtime.harness.retry_policy
    agent_runtime.harness.operation_values
    agent_runtime.harness.tool_ops
    agent_runtime.harness.turn_ops
    agent_runtime.harness.tool_orchestrator
    agent_runtime.harness.tool_router
forbidden_modules =
    agent_runtime.harness.services
    agent_runtime.harness.session
    agent_runtime.harness.execution

[importlinter:contract:core_does_not_depend_on_harness_orchestration]
name = Core does not depend on Harness orchestration
type = forbidden
source_modules =
    agent_runtime.core
forbidden_modules =
    agent_runtime.harness.services
    agent_runtime.harness.session
    agent_runtime.harness.execution

[importlinter:contract:rollout_persistence_has_no_business_policy]
name = Rollout persistence does not own runtime business policy
type = forbidden
source_modules =
    agent_runtime.harness.rollout
    agent_runtime.harness.rollout_integrity
    agent_runtime.harness.rollout_backup
forbidden_modules =
    agent_runtime.harness.runtime_store
    agent_runtime.harness.protocol
    agent_runtime.harness.session
    agent_runtime.harness.execution
    agent_runtime.harness.tool_orchestrator
    agent_runtime.budget
    agent_runtime.approval
    agent_runtime.planning
    agent_runtime.modeling
allow_indirect_imports = true

[importlinter:contract:praxis_layers]
name = Praxis layers point downward only
type = layers
layers =
    praxis.interfaces
    praxis.core
    praxis.store
    praxis.protocol

[importlinter:contract:praxis_tools_adapters_boundary]
name = Praxis tools and adapters never reach core/store/interfaces
type = forbidden
source_modules =
    praxis.tools
    praxis.adapters
forbidden_modules =
    praxis.core
    praxis.store
    praxis.interfaces

[importlinter:contract:praxis_core_purity]
name = Praxis core receives tools/adapters via protocol interfaces only
type = forbidden
source_modules =
    praxis.core
forbidden_modules =
    praxis.tools
    praxis.adapters
    praxis.interfaces

[importlinter:contract:praxis_no_legacy]
name = Praxis never imports the legacy runtime
type = forbidden
source_modules =
    praxis
forbidden_modules =
    agent_runtime

[importlinter:contract:praxis_verify_offline]
name = Praxis write path never calls verify
type = forbidden
source_modules =
    praxis.store.log
    praxis.store.turns
forbidden_modules =
    praxis.store.verify

[importlinter:contract:praxis_cli_via_sdk]
name = Praxis CLI talks to core only through the SDK
type = forbidden
source_modules =
    praxis.interfaces.cli
forbidden_modules =
    praxis.core
    praxis.store
allow_indirect_imports = true
